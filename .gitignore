# =========================
# CodeIgniter 4
# =========================

# Writable (logs, cache, sessions, uploads temporales)
writable/
!writable/.gitkeep

# Environment
.env

# Cache
*.cache
*.log

# =========================
# Vendor / Dependencias
# =========================
vendor/

# =========================
# IDEs / Editores
# =========================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# =========================
# Sistema Operativo
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
