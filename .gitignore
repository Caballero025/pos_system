# =========================
composer.lock
package-lock.json
node_modules/

# =========================
# Archivos temporales
# =========================
*.tmp
*.bak
*.swp

# =========================
# Logs de servidor
# =========================
*.log
apache.log
php_error.log

# =========================
# Uploads (si no quieres versionarlos)
# =========================
public/uploads/
