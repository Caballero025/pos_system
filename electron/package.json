{
  "name": "pos_system_desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.pos_system.desktop",
    "productName": "POS System",
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "php",
        "to": "php"
      },
      {
        "from": "../public",
        "to": "public"
      }
    ]
  }
}
